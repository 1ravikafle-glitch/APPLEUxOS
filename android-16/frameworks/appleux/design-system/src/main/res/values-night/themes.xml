<?xml version="1.0" encoding="utf-8"?>
<!--
    Dark-appearance overrides for Theme.Appleux.

    MOSTLY INHERITED. values/colors.xml and values-night/colors.xml already
    resolve @color/* differently per uiMode, so the base theme's colour items
    need no dark counterpart — that is the whole reason the palette was
    consolidated into design-system instead of being duplicated per app.

    What genuinely differs in dark appearance is only what the theme cannot
    express as a colour:

      1. windowLightStatusBar / windowLightNavigationBar must flip, or the
         status bar icons stay dark-on-black and vanish.
      2. A disabled state in dark mode needs a visible fill, not just a
         dimmed text colour, or a disabled filled button looks enabled.

    settings/values-night/themes.xml used to be a byte-for-byte copy of the
    light theme, which is why dark mode was a no-op in the Settings app.
    There is no per-app night theme any more; this is the only one.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Appleux" parent="Theme.Appleux.Base">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

    <style name="Theme.Appleux.Dialog" parent="Theme.Appleux.Dialog.Base">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

</resources>