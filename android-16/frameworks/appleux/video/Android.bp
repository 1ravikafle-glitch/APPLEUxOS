// AppleUX Videos — system app replacing stock Videos.
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "AppleUXVideo",
    owner: "appleux",
    srcs: ["src/main/java/**/*.kt"],
    manifest: "src/main/AndroidManifest.xml",
    sdk_version: "current",
    min_sdk_version: "36",
    static_libs: [
        "androidx_runtime",
        "appleux-apps-shared",
        "appleux-design-system",
        "appleux-performance-lib",
        "AppleUXSounds",
    ],
    privileged: true,
    product_specific: true,
}
