<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.appleux.launcher">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Widget host: BIND_APPWIDGET is signature|privileged (AOSP source),
         pre-granted to this priv-app via privapp-permissions-com.appleux.xml,
         so widget binding never shows a consent dialog. -->
    <uses-permission android:name="android.permission.BIND_APPWIDGET" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Recently Deleted restore re-inserts archived messages into the SMS
         provider. Writing there requires WRITE_SMS, which has no public
         Manifest.permission constant, so the name is spelled out literally. -->
    <uses-permission android:name="android.permission.WRITE_SMS" />
    <uses-permission android:name="android.permission.CAPTURE_AUDIO_OUTPUT" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- FilesActivity: Recently Deleted moves real files into
         .appleux_trash and back, and the Locations cards report per-volume
         capacity. Both need to read and write other volumes' files, so the
         legacy write permission covers API 29 and below and all-files access
         covers the scoped-storage eras. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- USB OTG enumeration for the Locations section. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-permission android:name="com.appleux.settings.permission.READ_APPLEUX_CONFIG" />

    <application
        android:name=".LauncherApplication"
        android:label="@string/app_name"
        android:theme="@style/AppleuxLauncherTheme">

        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- AppleUX built-in app shells (launcher-owned, no CATEGORY_LAUNCHER). -->
        <!-- System takeover: VIEW/EDIT/INSERT contact intents resolve here,
             so stock Contacts never opens from any app entry point. -->
        <activity android:name=".apps.ContactsActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.dir/contact" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/contact" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.INSERT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.dir/raw_contact" />
            </intent-filter>
        </activity>
        <!-- System takeover: DIAL goes here; the default-dialer role (asked
             in-app, one tap) makes CALL go here too. -->
        <service
            android:name=".apps.AppleuxInCallService"
            android:permission="android.permission.BIND_INCALL_SERVICE"
            android:exported="true">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>
        <activity android:name=".apps.PhoneActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.CALL_BUTTON" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- System takeover: smsto:/sms:/mms: links open here; the default-SMS
             role (asked in-app) completes the replacement for sending. -->
        <activity android:name=".apps.MessagesActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="smsto" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="mms" />
            </intent-filter>
        </activity>
        <activity android:name=".apps.PhotosActivity" android:exported="true" />
        <activity android:name=".apps.CameraActivity" android:exported="true" />
        <activity android:name=".apps.ClockActivity" android:exported="true" />
        <activity android:name=".apps.CalendarActivity" android:exported="true" />
        <activity android:name=".apps.FilesActivity" android:exported="true" />
        <activity android:name=".apps.BrowserActivity" android:exported="true" />

        <!-- AppleUX widget pack (iOS S/M/L proportions, zero polling). -->
        <receiver
            android:name=".widgets.AppleuxClockWidgetProvider"
            android:exported="true"
            android:label="@string/widget_clock">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_clock" />
        </receiver>
        <receiver
            android:name=".widgets.AppleuxBatteryWidgetProvider"
            android:exported="true"
            android:label="@string/widget_battery">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_battery" />
        </receiver>
        <receiver
            android:name=".widgets.AppleuxCalendarWidgetProvider"
            android:exported="true"
            android:label="@string/widget_calendar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_calendar" />
        </receiver>
    </application>
</manifest>
