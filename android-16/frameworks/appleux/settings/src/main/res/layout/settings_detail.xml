<?xml version="1.0" encoding="utf-8"?>
<!--
  iOS detail page chrome: a navigation bar with a back chevron + large title,
  then a content column. Owned detail pages (Wi-Fi, Battery, Display, Security)
  all inflate this, so the back affordance and title placement stay identical
  across the tree instead of drifting per page.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/detailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/system_grouped_background"
    android:orientation="vertical">

    <!-- Navigation bar: back chevron on the leading edge, title centred. -->
    <FrameLayout
        android:id="@+id/detailNavBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/system_grouped_background">

        <TextView
            android:id="@+id/detailBack"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:minWidth="44dp"
            android:minHeight="44dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="12dp"
            android:text="‹"
            android:textColor="@color/system_blue"
            android:textSize="34sp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/settings_back" />

        <TextView
            android:id="@+id/detailTitle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/label"
            android:maxLines="1"
            android:ellipsize="end" />
    </FrameLayout>

    <!-- Host slot: detail views and scrolling lists attach here. -->
    <FrameLayout
        android:id="@+id/detailContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>