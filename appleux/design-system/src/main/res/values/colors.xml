    <!--
      Sheet grab handle.

      PROVENANCE: AppleUX-chosen. iOS draws the handle in a translucent label
      colour that reads on any material beneath it and publishes no fixed
      value; this tracks ColorTokens.systemGray. The night variant in
      values-night/colors.xml is lighter so it keeps contrast on dark glass.

      This resource previously had no definition at all and
      drawable/appleux_sheet_handle.xml painted a transparent solid, which made
      the sheet's only drag affordance completely invisible.
    -->
    <color name="appleux_sheet_handle">#338E8E93</color>
