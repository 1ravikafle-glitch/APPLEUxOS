// AppleUX Design System — shared component library.
//
// Built from the canonical sources in OsProject/appleux/design-system, linked
// into the AOSP tree at frameworks/appleux. Do NOT re-copy the sources into
// the tree: see deliverables/m22/single-source-tree.md.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_library {
    name: "appleux-design-system",
    owner: "appleux",
    manifest: "src/main/AndroidManifest.xml",
    srcs: ["src/main/java/**/*.java", "src/main/java/**/*.kt"],
    kotlin: {
        enabled: true,
    },
    sdk_version: "current",
    min_sdk_version: "36",
    resource_dirs: ["src/main/res"],
    static_libs: [
        // This manifest carries no external/androidx, so the named AndroidX
        // modules do not exist. androidx_runtime is the aggregate built from
        // external/androidx-prebuilts (the same AARs the SDK route uses).
        "androidx_runtime",
        // Runtime display profile + refresh-rate-derived frame budget. Defined
        // by device-support/rock, linked into the tree at
        // hardware/xiaomi-appleux/rock.
        "appleux-device-support-rock",
    ],
    product_specific: true,
}