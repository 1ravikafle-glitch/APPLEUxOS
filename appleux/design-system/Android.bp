// AppleUX Design System - AOSP build module
// Android library providing iOS-27-inspired design tokens, motion constants,
// and reusable UI components for low-end hardware optimization.

package {
    default_applicable_licenses: ["Android-src-setup"],
}

android_library {
    name: "appleux-design-system",
    owner: "appleux",
    manifest: "src/main/AndroidManifest.xml",
    srcs: ["src/main/java/**/*.java", "src/main/java/**/*.kt"],
    kotlin: {
        enabled: true,
    },
    sdk_version: "current",
    min_sdk_version: "36",
    resource_dirs: ["src/main/res"],
    static_libs: [
        "androidx.appcompat_appcompat",
        "androidx.recyclerview_recyclerview",
        "androidx.core_core-ktx",
        "androidx.dynamicanimation_dynamicanimation",
        // Runtime display profile + refresh-rate-derived frame budget.
        // Lives outside the tree so device adapters are not build-mixed into
        // the design system; sources are symlinked in at
        // src/main/java/com/appleux/device so the Gradle-free kotlinc path
        // picks them up too (both paths must compile the same code).
        "appleux-device-support-rock",
    ],
    libs: ["android.framework"],
}