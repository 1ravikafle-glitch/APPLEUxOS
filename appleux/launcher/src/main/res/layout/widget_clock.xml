<?xml version="1.0" encoding="utf-8"?>
<!--
  Clock widget card: left-aligned stack, big time over a date line.

  iOS medium-widget proportions: wide card, left-aligned stack. RemoteViews-safe
  views only (TextClock, TextView — no ViewStub, no custom views).

  PROVENANCE for the type treatment:
   - The DOMINANT numeral is BOLD with slightly tightened tracking.
     PROTOTYPE-DERIVED from IOSLikeROM: `theme/GlassTheme.kt` sets its big
     numerals `fontWeight = FontWeight.Bold`, and `lockscreen/LockScreen.kt`
     sets the 96sp lock clock `letterSpacing = (-2).sp` — i.e. about -0.021em,
     which is what this -0.02 em reproduces. We shipped a regular-weight 44sp
     time with default tracking, which read as an ordinary TextView rather than
     a clock.
   - The date line is SEMIBOLD at 15sp. PROTOTYPE-DERIVED: `Glass.bodyBold`
     (15sp / FontWeight.SemiBold).
   - #99FFFFFF for the date line. PROTOTYPE-DERIVED: `Glass.labelDim` is
     #B3FFFFFF; #99 is slightly dimmer and keeps the time dominant. Ours.
   - 44sp / 15sp sizes: AppleUX-chosen for a 3-of-5-column widget card.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_clock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_dark"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="20dp">

    <TextClock
        android:id="@+id/widget_clock_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="h:mm"
        android:format24Hour="H:mm"
        android:letterSpacing="-0.02"
        android:textColor="#FFFFFFFF"
        android:textSize="44sp"
        android:textStyle="bold" />

    <TextClock
        android:id="@+id/widget_clock_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="EEEE, MMM d"
        android:format24Hour="EEEE, MMM d"
        android:textColor="#99FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>