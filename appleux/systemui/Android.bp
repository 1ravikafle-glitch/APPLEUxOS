// AppleUX SystemUI — replaces frameworks/base/packages/SystemUI.
//
// Built from the canonical sources in OsProject/appleux/systemui, linked into
// the AOSP tree at packages/apps/AppleUXSystemUI.
//
// Two fixes worth remembering:
//   * privileged: true is mandatory. STATUS_BAR and WRITE_SECURE_SETTINGS are
//     signature|privileged; for a /system/app APK they are denied at runtime no
//     matter what the allowlist says.
//   * "required: [AndroidSystemHandler]" was here and that module does not exist
//     anywhere in this tree, so the build could never have resolved it.
//
// Module name is AppleUXSystemUI to match device/xiaomi/rock/appleux.mk. The
// APK package stays com.appleux.systemui.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "AppleUXSystemUI",
    owner: "appleux",
    srcs: ["src/main/java/**/*.kt"],
    manifest: "src/main/AndroidManifest.xml",
    resource_dirs: ["src/main/res"],
    kotlin: {
        enabled: true,
    },
    sdk_version: "current",
    min_sdk_version: "36",
    static_libs: [
        "androidx_runtime",
        "appleux-design-system",
        "appleux-performance-lib",
    ],
    privileged: true,
    required: ["appleux-design-system", "appleux-performance-lib"],
    product_specific: true,
}