package {
    default_applicable_licenses: ["Android-src-setup"],
}

android_app {
    name: "AppleuxSystemUI",
    owner: "appleux",
    srcs: ["src/main/java/**/*.kt"],
    resource_dirs: ["src/main/res"],
    manifest: "src/main/AndroidManifest.xml",
    kotlin: {
        enabled: true,
    },
    sdk_version: "current",
    min_sdk_version: "36",
    static_libs: [
        "appleux-design-system",
        "androidx.core_core-ktx",
        "androidx.recyclerview_recyclerview",
    ],
    libs: ["android.framework"],
    system_libs: [
        "frameworks-base-core-lib",
    ],
    required: [
        "AndroidSystemHandler",
    ],
}

// Gradle build for the SDK emulator path.
// Soong (Android.bp) cannot run outside a full AOSP tree. This module layout
// lets appleux-design-system and the apps be built with plain build-tools.
//
//   aapt2 compile --dir src/main/res -o compiled.zip
//   javac/kotlinc + d8 -> classes.dex
//   aapt2 link + zipalign + apksigner
//
// See deliverables/m7/build-verification-and-cuttlefish-integration.md
// for the full story. scripts/build-emulator-apks.sh drives this.