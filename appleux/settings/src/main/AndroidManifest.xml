<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.appleux.settings">

    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <permission
        android:name="com.appleux.settings.permission.READ_APPLEUX_CONFIG"
        android:protectionLevel="signature" />

    <application
        android:name=".SettingsApplication"
        android:label="@string/app_name"
        android:theme="@style/AppleuxSettingsTheme">

        <provider
            android:name=".config.AppleuxConfigProvider"
            android:authorities="com.appleux.settings.config"
            android:exported="true"
            android:readPermission="com.appleux.settings.permission.READ_APPLEUX_CONFIG"
            android:writePermission="com.appleux.settings.permission.READ_APPLEUX_CONFIG" />

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Source-level defaulting: AppleUX answers system settings
                 intents; stock Settings remains as fallback until
                 ACTION_SETTINGS coverage is fully audited. -->
            <intent-filter>
                <action android:name="android.settings.SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.SettingsListActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:parentActivityName=".SettingsActivity" />

        <activity
            android:name=".display.DisplaySettingsActivity"
            android:exported="false"
            android:label="@string/display"
            android:parentActivityName=".SettingsActivity" />

        <activity
            android:name=".security.SecuritySettingsActivity"
            android:exported="false"
            android:label="@string/security"
            android:parentActivityName=".SettingsActivity" />

        <activity
            android:name=".performance.PerformanceSettingsActivity"
            android:exported="false"
            android:label="@string/adaptive_performance"
            android:parentActivityName=".SettingsActivity" />
    </application>
</manifest>